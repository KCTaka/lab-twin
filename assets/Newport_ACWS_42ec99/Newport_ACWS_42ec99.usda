            )
            {
                rel material:binding = </Newport_ACWS_42ec99/Looks/painted_steel_white>
                rel material:binding:physics = </Newport_ACWS_42ec99/Looks/PhysicsMaterial> (
                    bindMaterialAs = "weakerThanDescendants"
