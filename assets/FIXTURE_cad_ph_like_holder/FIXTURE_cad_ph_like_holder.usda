#usda 1.0
(
    defaultPrim = "FIXTURE_cad_ph_like_holder"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FIXTURE_cad_ph_like_holder" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @FIXTURE_cad_ph_like_holder.usda@
        string name = "FIXTURE_cad_ph_like_holder"
        string version = "c3f8a74408b8"
    }
    customData = {
        dictionary lab_twin = {
            string body = "dynamic"
            string expected_bbox_mm = "[[-9.5250001, -9.5250001, 0.0], [9.5250001, 9.5250001, 76.20000019999999]]"
            string family = "cad"
            string manufacturer = "FIXTURE"
            double mass_kg = 0.034237
            string part_number = "ph_like_holder"
            string provisional_params = ""
            string route = "VENDOR_STEP"
            string spec_sha = "c3f8a74408b8"
        }
    }
    kind = "component"
)
{
    float physics:mass = 0.034237
    token[] semantics:labels:class = ["optomechanics"]

    def Scope "Looks"
    {
        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "cad_default"
        {
            token outputs:surface.connect = </FIXTURE_cad_ph_like_holder/Looks/cad_default/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.75, 0.75)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Xform "Geometry"
    {
        float3 xformOp:scale = (0.001, 0.001, 0.001)
        double3 xformOp:translate = (-0, -0, -0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

        def "cad" (
            prepend references = @./cad/cad_raw.usda@
        )
        {
            over "tn__OpenCASCADESTEPtranslator791_XTCHSV0fF"
            {
                over "Mesh" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    rel material:binding = </FIXTURE_cad_ph_like_holder/Looks/cad_default>
                    rel material:binding:physics = </FIXTURE_cad_ph_like_holder/Looks/PhysicsMaterial> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    uniform token physics:approximation = "convexDecomposition"
                }
            }
        }
    }

    def Scope "KeyPoints"
    {
        def Xform "mount_hole_0" (
            customData = {
                string data = '{"auto": true, "diameter_mm": 5.11, "thread_guess": {"thread": "1/4-20", "matched": "tap_drill", "err_mm": 0.0}}'
                double3 normal = (0, 0, -1)
                bool support = 0
            }
        )
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "top_hole_0" (
            customData = {
                string data = '{"auto": true, "diameter_mm": 12.7, "thread_guess": {"thread": "SM05 (0.535-40)", "matched": "tap_drill", "err_mm": 0.0}}'
                double3 normal = (0, 0, 1)
                bool support = 0
            }
        )
        {
            double3 xformOp:translate = (0, 0, 0.0762)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

